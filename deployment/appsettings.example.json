{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2",
      "SslProtocols": [
        "Tls12",
        "Tls13"
      ]
    },
    "Endpoints": {
      "HTTP": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Diagnostics": {
    "Enabled": false,
    "Directory": "/app/Diagnostics",
    "MaxFileBytes": 4194304,
    "MaxFiles": 8,
    "RetentionDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [],
  "TrustedProxies": [
    "192.0.2.10"
  ],
  "JwtSettings": {
    "Key": "REPLACE_WITH_RANDOM_JWT_KEY",
    "Issuer": "ZeroHourPrivate",
    "Audience": "ZeroHourPrivate",
    "ExpiresInMinutes_Session": 15,
    "ExpiresInMinutes_Refresh": 1440
  },
  "Core": {
    "use_os_cert_store": true,
    "cert_pem_path": null,
    "cert_key_path": null,
    "cert_reload_interval_seconds": 30,
    "disable_full_mesh_check": false,
    "full_mesh_check_attempt_window_ms": 8000,
    "full_mesh_check_snapshot_interval_ms": 1000,
    "full_mesh_check_retry_delay_ms": 3000,
    "full_mesh_check_max_attempts": 2,
    "reconnect_grace_period_ms": 30000
  },
  "TURN": {
    "key": null,
    "token": null,
    "token_ttl": -1
  },
  "API": {
    "keys": []
  },
  "Discord": {
    "enable_discord": false,
    "discord_admins": [],
    "discord_network_room_chat_channel": -1,
    "discord_admin_commands_channel": -1
  },
  "Database": {
    "db_host": "db",
    "db_name": "zerohour",
    "db_username": "zerohour",
    "db_password": "REPLACE_WITH_DATABASE_PASSWORD",
    "db_port": 3306,
    "db_connect_timeout": 10,
    "db_command_timeout": 10,
    "db_min_poolsize": 0,
    "db_max_poolsize": 20,
    "db_use_pooling": true,
    "db_conn_reset": true
  },
  "MatchData": {
    "upload_match_data": false,
    "s3_access_key": null,
    "s3_secret_key": null,
    "s3_bucket_name": null,
    "s3_endpoint": null
  },
  "Sentry": {
    "enabled": false,
    "dsn": ""
  },
  "Middleware": {
    "jwks_endpoint": null,
    "audience": null,
    "issuer": null
  },
  "ExternalLeaderboards": {
    "PostUrl": null,
    "GetUrl": null,
    "GetToken": null,
    "PostToken": null
  },
  "PrivateService": {
    "Enabled": true,
    "InvitationSHA256": "REPLACE_WITH_SHA256_OF_INVITATION",
    "TurnSecret": "REPLACE_WITH_SHARED_TURN_SECRET",
    "WebSocketUrl": "wss://game.example.org/env/prod/contract/1/ws",
    "NativeClientCRC32": 1753285846
  },
  "RateLimiting": {
    "use_builtin_ratelimiter": true
  }
}
